# --- Clock ---
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF PORT "clk_25mhz" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# --- Buttons ---
LOCATE COMP "btn[0]" SITE "D6";   IOBUF PORT "btn[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[1]" SITE "R1";   IOBUF PORT "btn[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[2]" SITE "T1";   IOBUF PORT "btn[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[3]" SITE "R18";  IOBUF PORT "btn[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[4]" SITE "V1";   IOBUF PORT "btn[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[5]" SITE "U1";   IOBUF PORT "btn[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "btn[6]" SITE "H16";  IOBUF PORT "btn[6]" IO_TYPE=LVCMOS33;

# --- GPDI TMDS Outputs ---
LOCATE COMP "gpdi_dp[0]" SITE "A16";
LOCATE COMP "gpdi_dp[1]" SITE "A14";
LOCATE COMP "gpdi_dp[2]" SITE "A12";
LOCATE COMP "gpdi_dp[3]" SITE "A17";

IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4;
